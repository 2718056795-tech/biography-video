{
  "schema_version": "2.2",
  "policy_id": "biography-geographic-context-2.2",
  "layout_profile_id": "biography-paper-cut-series-2.2",
  "basemap": {
    "coast": {
      "width": 1.15,
      "alpha": 155
    },
    "river": {
      "width": 0.9,
      "alpha": 140
    },
    "minimum_visible_length_px": 24,
    "allowed_geometry_types": [
      "LineString",
      "MultiLineString"
    ],
    "country_polygons_are_coasts": false,
    "clipping": "segment intersection with geographic viewport; split at exits and antimeridian discontinuities"
  },
  "viewport": {
    "automatic_minimum_longitude_span_deg": 8,
    "automatic_minimum_latitude_span_deg": 5,
    "route_padding_fraction": 0.18,
    "empty_context_expansion_factor": 1.5,
    "empty_context_expansion_attempts": 2,
    "explicit_bounds_expand": false
  },
  "readability": {
    "method": "WCAG relative luminance contrast after source-over alpha compositing on theme paper",
    "map_coast": [
      {
        "purpose": "coast",
        "alpha": 155,
        "minimum_contrast": 1.5
      },
      {
        "purpose": "river",
        "alpha": 140,
        "minimum_contrast": 1.5
      }
    ],
    "map_ink": [
      {
        "purpose": "visited_node",
        "alpha": 65,
        "minimum_contrast": 1.3
      }
    ],
    "map_accent": [
      {
        "purpose": "old_route_minimum",
        "alpha": 210,
        "minimum_contrast": 2.5
      },
      {
        "purpose": "completed_route",
        "alpha": 210,
        "minimum_contrast": 2.5
      },
      {
        "purpose": "current_label",
        "alpha": 245,
        "minimum_contrast": 4.5
      },
      {
        "purpose": "region",
        "alpha": 130,
        "minimum_contrast": 1.8
      }
    ],
    "adaptation": "blend map colors toward contrasting theme ink, then black or white if required; preserve other theme roles"
  },
  "route_stroke": {
    "width": 2.1,
    "alpha": 210,
    "halo_width": 4.5,
    "halo_alpha": 64,
    "all_segments_same": true,
    "aging": false,
    "preview_uses_same_stroke": true
  },
  "labels": {
    "persistence": "unique node IDs through all completed arrivals; no future names",
    "layout": "once for all itinerary nodes, routes and region annotations",
    "font_size": 28,
    "font_bold": true,
    "color_role": "map_accent",
    "alpha": 245,
    "stroke_px": 2,
    "halo_alpha": 245,
    "panel_margin_px": 4,
    "label_gap_px": 3,
    "node_clearance_px": 9,
    "region_clearance_px": 3,
    "route_clearance_px": 2,
    "leader_width": 1,
    "leader_alpha": 180,
    "candidate_gaps_px": [
      13,
      24,
      40,
      56,
      80,
      104
    ],
    "candidate_angle_step_deg": 30,
    "search_budget": 100000,
    "overview": "full route preview; no arrived nodes or place labels",
    "route_overlap_fallback": "prefer zero route intersections; if fitting requires overlap, labels paint last with paper halo",
    "failure": "raise; widen viewport, shorten supplied labels or split regional views; never shrink or drop labels"
  }
}
