        "full_opacity_after_sec": 1.13,
        "fade_out_begins_sec": 6.383333333333333
      },
      {
        "text": "他把个人的困顿，写成对世间饥寒的关切。",
        "size_px": 30,
        "bounds": [
          120,
          1450,
          690,
          1481
        ],
        "role": "assessment",
        "full_opacity_after_sec": 1.73,
        "fade_out_begins_sec": 6.383333333333333
      }
    ]
  },
  {
